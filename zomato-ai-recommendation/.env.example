# Groq (OpenAI-compatible API) — copy this file to .env
LLM_PROVIDER=groq
GROQ_API_KEY=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
LLM_MODEL=llama-3.3-70b-versatile
